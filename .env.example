# Zhipu GLM (OpenAI-compatible)
JUDGE_API_KEY=your_bigmodel_api_key
JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Prefer glm-4-flash for lower latency; use glm-4 for quality
JUDGE_MODEL=glm-4-flash
JUDGE_REQUEST_TIMEOUT=90
JUDGE_MAX_RETRIES=2

USE_LLM_SCORING=true
USE_LLM_REPORT=true
# Single LLM call per question (set true for CoT + critique + rewrite — slower)
USE_QUESTION_CRITIQUE=false

# Unset REDIS_URL to use in-memory sessions (single process).
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400
# Optional Celery worker (pip install -e ".[worker]")
# CELERY_BROKER_URL=redis://localhost:6379/1
LOG_FORMAT=json
LOG_LEVEL=INFO
